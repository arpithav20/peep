rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user exists and has user role
    function isUser() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user';
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Only allow creation during signup (no existing user doc)
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       !exists(/databases/$(database)/documents/users/$(userId));
      
      // Users can update their own profile, admins can update any
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Resources collection
    match /resources/{resourceId} {
      // All authenticated users can read resources
      allow read: if isAuthenticated();
      
      // Only admins can create, update, or delete resources
      allow create, update, delete: if isAdmin();
    }

    // User resource progress tracking
    match /userResourceProgress/{progressId} {
      // Users can read their own progress, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create/update their own progress
      allow create, update: if isAuthenticated() && 
                               request.auth.uid == resource.data.userId;
      
      // Only admins can delete progress records
      allow delete: if isAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      // Users can read projects assigned to them or their own self-projects
      // Admins can read all projects
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.type == 'assigned' && 
         request.auth.uid in resource.data.assignedTo)
      );
      
      // Only admins can create assigned projects
      // Users can create self-projects
      allow create: if isAuthenticated() && (
        (isAdmin() && request.resource.data.type == 'assigned') ||
        (isUser() && request.resource.data.type == 'self' && 
         request.resource.data.userId == request.auth.uid)
      );
      
      // Users can update their own self-projects
      // Admins can update any project
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.type == 'self' && resource.data.userId == request.auth.uid)
      );
      
      // Only admins can delete projects
      allow delete: if isAdmin();
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Users can read their own submissions, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create submissions for their own projects
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.userId;
      
      // Users can update their own submissions (before review)
      // Admins can update any submission (for evaluation)
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'pending') ||
        isAdmin()
      );
      
      // Only admins can delete submissions
      allow delete: if isAdmin();
    }

    // Placements collection
    match /placements/{placementId} {
      // Users can read their own placements, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create their own placement records
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.userId;
      
      // Users can update their own placements, admins can update any
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can delete their own placements, admins can delete any
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Mistake Cards collection
    match /mistakeCards/{cardId} {
      // Users can read their own mistake cards, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create their own mistake cards
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.userId;
      
      // Users can update their own mistake cards
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Users can delete their own mistake cards, admins can delete any
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Announcements collection (admin only)
    match /announcements/{announcementId} {
      // All authenticated users can read announcements
      allow read: if isAuthenticated();
      
      // Only admins can create, update, or delete announcements
      allow create, update, delete: if isAdmin();
    }

    // System settings or configuration (admin only)
    match /settings/{settingId} {
      // Only admins can read, create, update, or delete settings
      allow read, write: if isAdmin();
    }

    // Analytics or logs (admin only)
    match /analytics/{analyticsId} {
      // Only admins can read, create, update, or delete analytics
      allow read, write: if isAdmin();
    }

    // Deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}